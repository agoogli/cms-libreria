# Database Credentials
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_secure_password
POSTGRES_DB=cms_db

# Database Connection URL (points to 'db' container as defined in podman-compose.yml)
DATABASE_URL=postgresql://cms:cms_secure_password@db:5432/cms_db

# Payload CMS Security
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# Cloudflare Turnstile Configuration (Optional, set to enable Turnstile server-side validation)
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
