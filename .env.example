# Database Credentials
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_secure_password
POSTGRES_DB=cms_db

# Database Connection URL (points to 'db' container as defined in podman-compose.yml)
DATABASE_URL=postgresql://cms:cms_secure_password@db:5432/cms_db

# Payload CMS Security
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# Cloudflare Turnstile Configuration (Optional, set to enable Turnstile server-side validation)
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend Email Notifications (Invia una mail quando un utente si registra)
# 1. Ottieni una chiave API gratuita su https://resend.com
RESEND_API_KEY=re_123456789abcdef
# 2. Indirizzo email dove vuoi ricevere le notifiche delle nuove registrazioni (es. la tua email)
NOTIFICATION_EMAIL_TO=info@librerianunnari.it
# 3. Mittente: all'inizio puoi usare "Libreria Nunnari <onboarding@resend.dev>", poi una volta verificato il dominio "Libreria Nunnari <notifiche@librerianunnari.it>"
NOTIFICATION_EMAIL_FROM="Libreria Nunnari <onboarding@resend.dev>"

